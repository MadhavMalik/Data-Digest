# ==========================================================
# Signal Engine — environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values. `.env` is gitignored.
# NEVER commit real credentials.
# ==========================================================

# ----------------------------------------------------------
# LLM / VLM provider (Llama 4 Scout is natively multimodal,
# so the same model serves the hypothesis stage and the
# graph-interpretation stage).
#
# LLM_BASE_URL must be an OpenAI-compatible endpoint: the
# client POSTs to {LLM_BASE_URL}/chat/completions with the
# standard messages/response_format payload. Providers that
# expose one for Llama 4 Scout, and work with no code change:
#
#   Together    https://api.together.xyz/v1
#   Groq        https://api.groq.com/openai/v1
#   Fireworks   https://api.fireworks.ai/inference/v1
#   DeepInfra   https://api.deepinfra.com/v1/openai
#   vLLM local  http://localhost:8000/v1
#
# Meta's own API is ALSO OpenAI-compatible and works unchanged:
#   Meta        https://api.meta.ai/v1
# Verified 2026-09-20: GET /v1/models returns an OpenAI-shaped
# listing and errors use the OpenAI error envelope. Note the
# model catalog on a Meta dev account may not include Llama-4
# (observed: muse-spark-1.3, sam-3.1, muse-image-1.0), and
# inference requires billing to be configured on the account --
# an unbilled key authenticates but returns HTTP 402.
# ----------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
# Optional: separate model for the multimodal/graph stage.
# Defaults to LLM_MODEL when blank (Scout handles both).
VLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=3

# ----------------------------------------------------------
# Elasticsearch — persistent semantic evidence memory.
# Prefer API-key auth. Do NOT use the built-in `elastic`
# superuser. Do NOT disable TLS verification.
#
# ELASTIC_DEPLOYMENT_TYPE: cloud-hosted | serverless | self-managed
# Provide EITHER ELASTIC_CLOUD_ID (Elastic Cloud hosted)
# OR ELASTIC_URL (serverless / self-managed endpoint).
# ----------------------------------------------------------
ELASTIC_DEPLOYMENT_TYPE=cloud-hosted
ELASTIC_CLOUD_ID=
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX_PREFIX=hackmit_signal
# Optional: a managed inference/embedding endpoint ID that already
# exists in your deployment (e.g. `.elser-2-elasticsearch` or a
# Jina/E5 endpoint you created). Leave blank to use the local
# deterministic embedder instead.
ELASTIC_INFERENCE_ENDPOINT_ID=
ELASTIC_EMBEDDING_DIMS=384
ELASTIC_REQUEST_TIMEOUT=30
ELASTIC_VERIFY_CERTS=true

# ----------------------------------------------------------
# Brave Search — optional external grounding, used ONLY when a
# relationship is statistically strong but the VLM cannot
# explain it, or when the user explicitly asks for context.
# ----------------------------------------------------------
BRAVE_SEARCH_API_KEY=__PLACEHOLDER__
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
BRAVE_MAX_RESULTS=5

# ----------------------------------------------------------
# Context compression (The Token Company adapter).
# `noop` = pass text through unchanged (default, always safe).
# `token_company` = use the hosted compression service.
# ----------------------------------------------------------
CONTEXT_COMPRESSOR=noop
TOKEN_COMPANY_API_KEY=__PLACEHOLDER__
TOKEN_COMPANY_BASE_URL=
TOKEN_COMPANY_MODEL=
COMPRESSION_TARGET_RATIO=0.5

# ----------------------------------------------------------
# Search budgets (all enforced; see docs/OPTIMIZATIONS.md)
# ----------------------------------------------------------
SEARCH_MAX_DEPTH=3
SEARCH_BEAM_WIDTH=8
SEARCH_MAX_CANDIDATES=20000
SEARCH_MAX_TESTS=4000
SEARCH_MAX_LLM_CALLS=25
SEARCH_MAX_VLM_CALLS=15
SEARCH_MAX_BRAVE_CALLS=5
SEARCH_WALL_CLOCK_SECONDS=900
SEARCH_NO_IMPROVEMENT_ROUNDS=3
SEARCH_MIN_IMPROVEMENT=0.02

# ----------------------------------------------------------
# Paths
# ----------------------------------------------------------
DATA_DIR=data
ARTIFACTS_DIR=artifacts
CACHE_DIR=.cache

# ----------------------------------------------------------
# Statistics
# ----------------------------------------------------------
STATS_SAMPLE_ROWS=2000000
STATS_MI_SAMPLE_ROWS=200000
STATS_STABILITY_FOLDS=5
STATS_MIN_SAMPLE_SIZE=100
PLOT_MAX_SCATTER_POINTS=20000
